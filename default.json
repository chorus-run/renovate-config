{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Chorus default for every product repository: grouped weekly update PRs; patch updates and non-major dev dependency updates automerge once status checks pass, everything else waits for the owner's review.",
  "extends": [
    "config:recommended",
    "schedule:weekly",
    "group:allNonMajor",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "America/Toronto",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "automerge": false,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Patch updates: one PR, automerged once status checks pass.",
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "all patch dependencies",
      "groupSlug": "all-patch",
      "automerge": true
    },
    {
      "description": "Non-major dev dependency updates: one PR, automerged once status checks pass.",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "all non-major dev dependencies",
      "groupSlug": "all-dev-non-major",
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": null
  },
  "branchPrefix": "chore/renovate-"
}
